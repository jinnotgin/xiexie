# Copy to .env.local to turn on "Sign in with Google" (see README). Leave unset to ship without it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# PostHog product analytics
VITE_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
# Optional: defaults to the managed reverse proxy (https://xiexie-peer.jinnotgin.com)
VITE_POSTHOG_HOST=
